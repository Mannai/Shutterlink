#include <winver.h>

#include "resource.h"
#include "version.h"  // generated by build.ps1: version numbers and the path of the built DLL

IDI_SHUTTERLINK ICON "shutterlink.ico"

IDR_SOURCE_DLL RCDATA SL_SOURCE_DLL_PATH

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SL_VERSION_NUM
 PRODUCTVERSION SL_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mannai"
            VALUE "FileDescription", "Shutterlink"
            VALUE "FileVersion", SL_VERSION_STR
            VALUE "InternalName", "Shutterlink"
            VALUE "LegalCopyright", "Copyright (C) 2026 Mannai. GPL-3.0-or-later."
            VALUE "OriginalFilename", "Shutterlink.exe"
            VALUE "ProductName", "Shutterlink"
            VALUE "ProductVersion", SL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
